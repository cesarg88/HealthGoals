{
  "sourceLanguage": "en",
  "strings": {
    "intention.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your activity, at your pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu actividad, a tu ritmo"
          }
        }
      }
    },
    "intention.promise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A goal for your week. Your days can be different."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo para tu semana. Tus días pueden ser diferentes."
          }
        }
      }
    },
    "intention.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to improve?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres mejorar?"
          }
        }
      }
    },
