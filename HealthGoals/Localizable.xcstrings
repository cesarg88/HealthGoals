    "home.insufficient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not find accessible activity for this week. Your remaining amount is unknown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos actividad accesible de esta semana. El restante es desconocido."
          }
