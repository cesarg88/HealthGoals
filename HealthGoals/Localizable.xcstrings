{
  "sourceLanguage": "en",
  "strings": {
    "intention.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your activity, at your pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu actividad, a tu ritmo"
          }
        }
      }
    },
    "intention.promise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A goal for your week. Your days can be different."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objetivo para tu semana. Tus días pueden ser diferentes."
          }
        }
      }
    },
    "intention.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to improve?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres mejorar?"
          }
        }
      }
    },
    "intention.walking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk more"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminar más"
          }
        }
      }
    },
    "intention.activity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move more"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moverme más"
          }
        }
      }
    },
    "metric.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly steps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos semanales"
          }
        }
      }
    },
    "metric.activity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly activity"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad semanal"
          }
        }
      }
    },
    "common.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        }
      }
    },
    "common.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver"
          }
        }
      }
    },
    "common.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "health.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Health"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con Salud"
          }
        }
      }
    },
    "health.connect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Health"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con Salud"
          }
        }
      }
    },
    "health.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will use your steps and active energy to understand your recent activity and follow your weekly goals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizaremos tus pasos y energía activa para entender tu actividad reciente y seguir tus objetivos semanales."
          }
        }
      }
    },
    "health.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only access. HealthGoals does not change your Health data or send it to a backend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso solo de lectura. HealthGoals no modifica tus datos de Salud ni los envía a un backend."
          }
        }
      }
    },
    "health.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health is not available right now. You can try again or go back; your choice is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud no está disponible ahora. Puedes reintentar o volver; tu selección se conserva."
          }
        }
      }
    },
    "health.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request could not be completed. Try again or go back; your choice is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la solicitud. Reintenta o vuelve; tu selección se conserva."
          }
        }
      }
    },
    "health.requesting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Health…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a Salud…"
          }
        }
      }
    },
    "startingPoint.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your starting point"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu punto de partida"
          }
        }
      }
    },
    "startingPoint.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recent activity will appear here when this feature is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu actividad reciente aparecerá aquí cuando esta función esté disponible."
          }
        }
      }
    },
    "startingPoint.requestCompleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Health request has finished. We have not checked which activity data is accessible yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de Salud ha terminado. Todavía no hemos comprobado qué datos de actividad son accesibles."
          }
        }
      }
    }
  },
  "version": "1.0"
}
