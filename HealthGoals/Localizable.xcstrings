    "goal.inputExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive whole number. Applying changes only your draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un entero positivo. Aplicar cambia solo el borrador."
          }
        }
      }
    },
