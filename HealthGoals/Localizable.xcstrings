    "goal.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little above your recent activity. You decide your goal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco por encima de tu actividad reciente. Tú decides el objetivo."
          }
        }
      }
    },
    "goal.adjust": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar"
          }
        }
      }
    },
    "goal.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este objetivo"
          }
        }
      }
    },
    "goal.proposal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To get started, we suggest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para empezar, te proponemos"
          }
        }
      }
    },
    "goal.firstWeek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We count activity from Monday, even if you start today. The goal covers the whole week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contamos la actividad desde el lunes, aunque empieces hoy. El objetivo es para la semana completa."
          }
        }
      }
    },
    "goal.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot suggest a positive goal from this baseline yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no podemos proponer un objetivo positivo con este punto de partida."
          }
        }
      }
    },
    "goal.input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
